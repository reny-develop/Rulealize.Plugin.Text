<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The vocabulary's own tests, where it lives. Each operation is evaluated by the Rulealize
    runtime as a projection of a rule set, and once as the check an input's validate clause makes,
    which is where a rule set uses it. The runtime and the other vocabularies come from nuget.org;
    the plugin is handed to the runtime as an instance, so the version under test is this
    repository's.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rulealize" Version="0.13.0" />
    <PackageReference Include="Rulealize.Plugin.TypeSchema" Version="1.3.0" />
    <PackageReference Include="Rulealize.Plugin.State" Version="1.0.1" />
    <PackageReference Include="Rulealize.Plugin.Binding" Version="1.0.1" />
    <PackageReference Include="Rulealize.Plugin.Logic" Version="1.0.1" />
    <PackageReference Include="Rulealize.Plugin.Comparison" Version="1.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rulealize.Plugin.Text\Rulealize.Plugin.Text.csproj" />
  </ItemGroup>

</Project>
